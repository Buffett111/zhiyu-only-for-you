{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zhiyu",
  "main": "edge/worker.ts",
  "compatibility_date": "2026-09-12",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "vars": {
    "API_ORIGIN": "http://127.0.0.1:3001"
  },
  "observability": {
    "enabled": false
  },
  "vpc_services": []
}
