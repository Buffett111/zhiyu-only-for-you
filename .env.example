# Run `npm run setup` to create a local .env with a random database password.
APP_MODE=development
HOST=127.0.0.1
PORT=3001
DATABASE_URL=postgresql://zhiyu:CHANGE_ME@127.0.0.1:54329/zhiyu
POSTGRES_PASSWORD=CHANGE_ME
DEV_USER_EMAIL=local@zhiyu.invalid
DEV_USER_NAME=我的知隅
# Production: set APP_MODE=production, allow only your actual public origin.
PUBLIC_ORIGIN=http://127.0.0.1:5173
ACCESS_TEAM_DOMAIN=
ACCESS_AUD=
ALLOWED_EMAILS=
ADMIN_EMAILS=
# Cloudflare provisioning uses local settings and the existing Wrangler login, or an API token.
# Keep these values in .env; never put account credentials or IDs in committed source.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_VPC_SERVICE_ID=
PG_CONTAINER=zhiyu-db
# setup generates this independently of the database password; save separately.
BACKUP_PASSPHRASE=

# Optional AI news summaries (server only; never use a VITE_ prefix)
OPENAI_API_KEY=
# Shared daily request cap in Asia/Taipei; 0 disables generation
AI_DAILY_REQUEST_LIMIT=40
